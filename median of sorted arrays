import time
import matplotlib.pyplot as plt
import random

def median_two_sorted_arrays(A, B):
    m, n = len(A), len(B)
    if m > n:
        return median_two_sorted_arrays(B, A)
    imin, imax, half = 0, m, (m+n+1)//2
    while imin <= imax:
        i = (imin+imax)//2
        j = half - i
        if i < m and B[j-1] > A[i]:
            imin = i+1
        elif i > 0 and A[i-1] > B[j]:
            imax = i-1
        else:
            if i == 0: max_left = B[j-1]
            elif j == 0: max_left = A[i-1]
            else: max_left = max(A[i-1], B[j-1])
            if (m+n) % 2 == 1:
                return max_left
            if i == m: min_right = B[j]
            elif j == n: min_right = A[i]
            else: min_right = min(A[i], B[j])
            return (max_left + min_right)/2

# Experiment
sizes = [10000, 20000, 30000, 40000, 50000]
measured_times, expected_times = [], []

for n in sizes:
    A = sorted([random.randint(0, n) for _ in range(n)])
    B = sorted([random.randint(0, n) for _ in range(n)])
    start = time.time()
    median_two_sorted_arrays(A, B)
    measured_times.append(time.time() - start)
    expected_times.append(len(bin(n))-2)  # ~ O(log n)

# Normalize expected
scale = measured_times[-1] / expected_times[-1]
expected_times = [t * scale for t in expected_times]

# Plot
plt.plot(sizes, measured_times, label="Measured Time")
plt.plot(sizes, expected_times, label="Expected O(log n)")
plt.xlabel("Array Size")
plt.ylabel("Execution Time (s)")
plt.title("Median of Two Sorted Arrays: Measured vs Expected")
plt.legend()
plt.show()
