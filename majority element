#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#define N 10000

int majorityElement(int arr[],int n){
    int cand=0,count=0;
    for(int i=0;i<n;i++){
        if(count==0) cand=arr[i];
        count += (arr[i]==cand)?1:-1;
    }
    return cand;
}

int main(){
    int arr[N]; srand(time(0));
    for(int i=0;i<N;i++) arr[i]=rand()%10;
    clock_t start=clock();
    int maj=majorityElement(arr,N);
    clock_t end=clock();
    printf("Majority Element: %d, Time: %.3f sec\n",maj,(double)(end-start)/CLOCKS_PER_SEC);
}
