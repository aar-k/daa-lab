#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#define N 10000

long long mergeCount(int arr[],int l,int m,int r){
    int n1=m-l+1,n2=r-m;
    int L[5000],R[5000];
    for(int i=0;i<n1;i++) L[i]=arr[l+i];
    for(int j=0;j<n2;j++) R[j]=arr[m+1+j];
    int i=0,j=0,k=l; long long inv=0;
    while(i<n1 && j<n2){
        if(L[i]<=R[j]) arr[k++]=L[i++];
        else {arr[k++]=R[j++]; inv+=(n1-i);}
    }
    while(i<n1) arr[k++]=L[i++];
    while(j<n2) arr[k++]=R[j++];
    return inv;
}

long long countInv(int arr[],int l,int r){
    long long inv=0;
    if(l<r){
        int m=(l+r)/2;
        inv+=countInv(arr,l,m);
        inv+=countInv(arr,m+1,r);
        inv+=mergeCount(arr,l,m,r);
    }
    return inv;
}

int main(){
    int arr[N]; srand(time(0));
    for(int i=0;i<N;i++) arr[i]=rand();
    clock_t start=clock();
    long long inv=countInv(arr,0,N-1);
    clock_t end=clock();
    printf("Inversions: %lld, Time: %.3f sec\n",inv,(double)(end-start)/CLOCKS_PER_SEC);
}
