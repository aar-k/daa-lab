#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void insertionSort(int arr[], int n){
    for(int i=1;i<n;i++){
        int key=arr[i], j=i-1;
        while(j>=0 && arr[j]>key){arr[j+1]=arr[j]; j--;}
        arr[j+1]=key;
    }
}

int main(){
    int N=10000;
    int arr[N]; srand(time(0));
    for(int i=0;i<N;i++) arr[i]=rand();
    clock_t start=clock();
    insertionSort(arr,N);
    clock_t end=clock();
    printf("Insertion Sort: %.3f sec\n",(double)(end-start)/CLOCKS_PER_SEC);
}
